HTTP_ADDR=:8080
SQLITE_PATH=./data/platform.db

MQTT_ADDR=:1883
BROKER_HOST_PUBLIC=192.168.1.100

JWT_SECRET=dev-jwt-secret-change-me
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@crearts.local
ADMIN_PASSWORD=admin

# Device-reachable base URL (OTA download, email links). Use LAN IP, not localhost, for ESP OTA.
PUBLIC_BASE_URL=http://localhost:8080
# IANA timezone for schedule / quiet hours (plugins). Override per binding via config.tz.
TIMEZONE=Asia/Bangkok
# OTA_DIR=./data/firmware
REGISTER_ENABLED=true
REGISTER_DEFAULT_ROLE=viewer
REQUIRE_EMAIL_VERIFY=true
EMAIL_MODE=log

# Google OAuth — create Web client in Google Cloud Console
# Authorized redirect URI must be exactly:
#   http://localhost:8080/api/v1/auth/google/callback
# (or your PUBLIC_BASE_URL + /api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

NODERED_URL=http://192.168.1.100:1880
NODERED_MQTT_USER=nodered
NODERED_MQTT_PASSWORD=nodered
RULES_BUS_ENABLED=true
