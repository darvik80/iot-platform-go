# NOTE: the platform binary does NOT read .env files.
# Use this file only as an env source for something that injects it into the process
# environment: `docker run --env-file`, Docker Compose `env_file:`, or systemd `EnvironmentFile=`.
# Resulting priority: OS env (incl. values injected from this file) > ./config.yml > /etc/iot-platform/config.yml.
# On a fresh install with an empty database the platform starts the setup wizard (http://<host>:8080/setup),
# which creates the admin user and default account and writes config.yml.

HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://192.168.1.22:8080
PLATFORM_NAME=Cogitor IoT
TIMEZONE=Asia/Bangkok
LOG_LEVEL=info

# sqlite (default, WAL) | postgres. SQLITE_PATH is a legacy alias used when DATABASE_DSN is empty.
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/platform.db
# DATABASE_DSN=postgres://user:pass@localhost:5432/iot_platform?sslmode=disable
# Parsed but currently NOT applied (pool size is hardcoded: sqlite 1, postgres 8).
DATABASE_MAX_OPEN_CONNS=8
# Firmware storage; default is {DATA_DIR}/firmware (DATA_DIR defaults to the SQLite file's directory).
OTA_DIR=./data/firmware

MQTT_ADDR=:1883
# MQTT over WebSocket (subprotocol mqtt). off / - to disable.
MQTT_WS_ADDR=:8083
# MQTT over TLS (mqtts). Listener starts only when cert + key are set.
# MQTT_TLS_ADDR=:8883
# MQTT_TLS_CERT=/etc/iot-platform/certs/mqtt/cert.pem
# MQTT_TLS_KEY=/etc/iot-platform/certs/mqtt/key.pem
# MQTT_TLS_CA=/etc/iot-platform/certs/mqtt/ca.pem  # optional: enables mutual TLS
BROKER_HOST_PUBLIC=192.168.1.22

# Change in production (the setup wizard generates a random secret into config.yml;
# a value set here overrides it).
JWT_SECRET=dev-jwt-secret-change-me
REGISTER_ENABLED=true
# Code default: admin. viewer is the recommended safer value.
REGISTER_DEFAULT_ROLE=viewer
# Code default: false. true is recommended when SMTP is configured.
REQUIRE_EMAIL_VERIFY=true

# ADMIN_* and BOOTSTRAP_ACCOUNT_* do NOT create an admin user or account —
# the setup wizard does. They are kept here for reference only.
# ADMIN_LOGIN=admin
# ADMIN_EMAIL=admin@cogitor.local
# ADMIN_PASSWORD=admin

EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cogitor.local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://192.168.1.22:8080/api/v1/auth/google/callback

NODERED_URL=http://192.168.1.22:1880
RULES_BUS_ENABLED=true
RULES_BUS_PREFIX=platform/v1

TELEMETRY_RETENTION_DAYS=30
RPC_DEFAULT_TIMEOUT_MS=30000
# Currently has no effect.
LAB_ALLOW_UNKNOWN_DEVICES=false

# BOOTSTRAP_ACCOUNT_SLUG=default
# BOOTSTRAP_ACCOUNT_NAME=Default
