[Unit]
Description=IoT Platform (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-platform
Group=iot-platform
WorkingDirectory=/opt/iot-platform
EnvironmentFile=/opt/iot-platform/etc/.env
ExecStart=/opt/iot-platform/bin/platform
Restart=on-failure
RestartSec=5
# Logs → /var/log/iot-platform/platform.log (rotated via /etc/logrotate.d/iot-platform)
StandardOutput=append:/var/log/iot-platform/platform.log
StandardError=append:/var/log/iot-platform/platform.log
SyslogIdentifier=iot-platform

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/iot-platform/etc /opt/iot-platform/lib /opt/iot-platform/certs /var/log/iot-platform
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
