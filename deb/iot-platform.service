[Unit]
Description=IoT Platform (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-platform
Group=iot-platform
WorkingDirectory=/var/lib/iot-platform-go
ExecStart=/usr/bin/iot-platform
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-platform

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/iot-platform-go /etc/iot-platform-go
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
