# Read by deploy/docker-compose.yml for variable substitution only.
# Platform settings go to platform.env (see platform.env.example).

# ── Platform container ───────────────────────────────────────────────────────
# Image to run; `docker compose build` tags the local build with this name.
# Prebuilt multi-arch image: darvik80/iot-platform:latest
IOT_IMAGE=localhost/iot-platform-go:latest
IOT_CONTAINER_NAME=iot-platform-go

# Host ports (left side of -p HOST:CONTAINER). Container ports are fixed:
# 8080 HTTP, 1883 MQTT, 8083 MQTT over WebSocket, 8883 MQTT over TLS.
# MQTT host ports are also announced to devices (MQTT_*_PUBLIC_PORT).
IOT_HTTP_PORT=8080
IOT_MQTT_PORT=1883
IOT_MQTT_WS_PORT=8083
IOT_MQTT_TLS_PORT=8883

# Host directories, relative to deploy/ or absolute.
# data → /opt/iot-platform/lib  SQLite database + firmware files
# etc  → /opt/iot-platform/etc  config.yml written by the setup wizard + certs
IOT_DATA_DIR=./iot/data
IOT_ETC_DIR=./iot/etc

# ── Node-RED (docker compose --profile nodered up -d) ────────────────────────
NODERED_PORT=1880
NODERED_CREDENTIAL_SECRET=cogitor-nodered-dev
# Broker host baked into the flow template on first start
# (Docker=host.docker.internal, Podman=host.containers.internal, the platform LAN IP,
# or "platform" when both run from this compose file). The template uses port 1883.
# MQTT_BROKER_HOST=host.docker.internal
# Node-RED has no dedicated MQTT credentials: register it as an external plugin
# (Settings -> External Plugins) and enter the extplg_{account_slug}_{plugin_id}
# user / password in the flow's MQTT broker node.
# The {account_slug} part of that user; the flow template subscribes to
# platform/v1/events/{ACCOUNT_SLUG}/+/+/status
# ACCOUNT_SLUG=default
