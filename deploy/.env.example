# ── Node-RED (read by deploy/docker-compose.yml) ─────────────────────────────
NODERED_CREDENTIAL_SECRET=cogitor-nodered-dev
# Broker host baked into the flow template on first start
# (Docker=host.docker.internal, Podman=host.containers.internal, or the platform LAN IP)
# MQTT_BROKER_HOST=host.docker.internal
# Node-RED has no dedicated MQTT credentials: register it as an external plugin
# (Settings -> External Plugins) and enter the extplg_{account_slug}_{plugin_id}
# user / password in the flow's MQTT broker node.
# The {account_slug} part of that user; the flow template subscribes to
# platform/v1/events/{ACCOUNT_SLUG}/+/+/status
# ACCOUNT_SLUG=default

# ── Platform (not used by docker-compose; e.g. systemd EnvironmentFile) ──────
JWT_SECRET=change-me-in-production
BROKER_HOST_PUBLIC=192.168.1.22
PUBLIC_BASE_URL=http://192.168.1.22:8080
MQTT_WS_ADDR=:8083
# MQTT_TLS_ADDR=:8883
# MQTT_TLS_CERT=/etc/iot-platform/certs/mqtt/cert.pem
# MQTT_TLS_KEY=/etc/iot-platform/certs/mqtt/key.pem
# MQTT_TLS_CA=/etc/iot-platform/certs/mqtt/ca.pem
TIMEZONE=Asia/Bangkok
LOG_LEVEL=info
# The first admin is created in the setup wizard on first start;
# ADMIN_EMAIL / ADMIN_PASSWORD do not create a user.
# ADMIN_EMAIL=admin@cogitor.local
# ADMIN_PASSWORD=admin
