# Platform (compose interpolates these into the container)
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@cogitor.local
ADMIN_PASSWORD=admin
BROKER_HOST_PUBLIC=192.168.1.22
PUBLIC_BASE_URL=http://192.168.1.22:8080
MQTT_WS_ADDR=:8083
# MQTT_TLS_ADDR=:8883
# MQTT_TLS_CERT=/etc/iot-platform-go/cert.pem
# MQTT_TLS_KEY=/etc/iot-platform-go/key.pem
# MQTT_TLS_CA=/etc/iot-platform-go/ca.pem
TIMEZONE=Asia/Bangkok
LOG_LEVEL=info
NODERED_MQTT_USER=nodered
NODERED_MQTT_PASSWORD=nodered
NODERED_CREDENTIAL_SECRET=cogitor-nodered-dev
