[
  {
    "id": "cogitor-tab",
    "type": "tab",
    "label": "Cogitor example",
    "disabled": false,
    "info": "Example: telemetry threshold → desired attribute / RPC"
  },
  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "cogitor-mqtt",
    "broker": "platform",
    "port": "1883",
    "clientid": "nodered-cogitor",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": 4,
    "keepalive": 60,
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "closeTopic": "",
    "willTopic": "",
    "credentials": {
      "user": "nodered",
      "password": "nodered"
    }
  },
  {
    "id": "in-telemetry",
    "type": "mqtt in",
    "z": "cogitor-tab",
    "name": "telemetry events",
    "topic": "platform/v1/events/+/+/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 120,
    "wires": [["threshold"]]
  },
  {
    "id": "threshold",
    "type": "function",
    "z": "cogitor-tab",
    "name": "temp > 30 → cool",
    "func": "const keys = msg.payload.keys || {};\nconst t = keys.temperature;\nif (typeof t === 'number' && t > 30) {\n    const product = msg.payload.product_id;\n    const device = msg.payload.device_id;\n    msg.topic = `platform/v1/commands/${product}/${device}/attributes/desired`;\n    msg.payload = { targetTemperature: 26, cooling: true };\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "x": 400,
    "y": 120,
    "wires": [["out-cmd"]]
  },
  {
    "id": "out-cmd",
    "type": "mqtt out",
    "z": "cogitor-tab",
    "name": "desired attr cmd",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt-broker",
    "x": 640,
    "y": 120,
    "wires": []
  },
  {
    "id": "in-status",
    "type": "mqtt in",
    "z": "cogitor-tab",
    "name": "status events",
    "topic": "platform/v1/events/+/+/status",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker",
    "x": 150,
    "y": 240,
    "wires": [["offline-alert"]]
  },
  {
    "id": "offline-alert",
    "type": "function",
    "z": "cogitor-tab",
    "name": "offline → debug",
    "func": "if (msg.payload.online === false) {\n    node.warn(`${msg.payload.product_id}.${msg.payload.device_id} offline (${msg.payload.reason || 'n/a'})`);\n}\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 240,
    "wires": [["debug1"]]
  },
  {
    "id": "debug1",
    "type": "debug",
    "z": "cogitor-tab",
    "name": "status",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 610,
    "y": 240,
    "wires": []
  }
]
