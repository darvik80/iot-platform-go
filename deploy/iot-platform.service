[Unit]
Description=IoT Platform (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-platform
Group=iot-platform
EnvironmentFile=/etc/iot-platform/.env
ExecStart=/usr/local/bin/iot-platform
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-platform

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/iot-platform /var/log/iot-platform
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
