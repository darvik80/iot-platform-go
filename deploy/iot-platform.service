[Unit]
Description=IoT Platform (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-platform
Group=iot-platform
WorkingDirectory=/opt/iot-platform
EnvironmentFile=/opt/iot-platform/etc/.env
ExecStart=/opt/iot-platform/bin/platform
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-platform

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/iot-platform/etc /opt/iot-platform/lib /opt/iot-platform/certs
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
