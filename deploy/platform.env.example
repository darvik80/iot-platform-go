# Optional: copy to platform.env to pass settings into the platform container.
# Every variable listed here overrides config.yml written by the setup wizard,
# so keep only what you want to pin. Do not leave variables with empty values:
# an empty variable still counts as set and hides the config.yml value.
# Full list: docs/en/11-operations.md#configuration

# URL users and devices open (host port from IOT_HTTP_PORT, or your reverse proxy).
# PUBLIC_BASE_URL=http://192.168.1.22:8080
# Host name / IP devices use to reach MQTT.
# BROKER_HOST_PUBLIC=192.168.1.22

# TIMEZONE=Asia/Bangkok
# LOG_LEVEL=info
# JWT_SECRET=<random 64 chars>

# PostgreSQL instead of the bundled SQLite file:
# DATABASE_DRIVER=postgres
# DATABASE_DSN=postgres://user:pass@db:5432/iot_platform?sslmode=disable

# MQTT over TLS: the listener starts only when cert + key exist.
# Files under IOT_ETC_DIR/certs/mqtt/ appear here as /opt/iot-platform/etc/certs/mqtt/.
# MQTT_TLS_CERT=/opt/iot-platform/etc/certs/mqtt/cert.pem
# MQTT_TLS_KEY=/opt/iot-platform/etc/certs/mqtt/key.pem
# MQTT_TLS_CA=/opt/iot-platform/etc/certs/mqtt/ca.pem
