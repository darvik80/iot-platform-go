# Priority: OS env > .env > ./config.yml > /etc/iot-platform-go/config.yml
# Flatten: nested YAML keys are joined with "_" and uppercased to env var names.
# Example: server.http_addr → SERVER_HTTP_ADDR, mqtt.addr → MQTT_ADDR
# .env uses PUBLIC_BASE_URL / HTTP_ADDR (those win if set).

server:
  http_addr: ":8080"                                  # env: SERVER_HTTP_ADDR (or HTTP_ADDR)
  platform_name: "Cogitor IoT"                        # env: SERVER_PLATFORM_NAME (or PLATFORM_NAME)

timezone: "Asia/Bangkok"                              # env: TIMEZONE
log_level: info                                       # env: LOG_LEVEL  —  debug | info | warn | error

database:
  driver: "sqlite"                                    # env: DATABASE_DRIVER  —  sqlite | postgres
  dsn: "./data/platform.db"                           # env: DATABASE_DSN
  # dsn: "postgres://user:pass@localhost:5432/iot_platform?sslmode=disable"
  max_open_conns: 8                                   # env: DATABASE_MAX_OPEN_CONNS

mqtt:
  addr: ":1883"                                       # env: MQTT_ADDR
  ws_addr: ":8083"                                    # env: MQTT_WS_ADDR  —  MQTT over WebSocket (off to disable)
  # tls_addr: ":8883"                                 # env: MQTT_TLS_ADDR  —  MQTT over TLS
  # tls_cert: "/etc/iot-platform-go/certs/cert.pem"   # env: MQTT_TLS_CERT
  # tls_key: "/etc/iot-platform-go/certs/key.pem"     # env: MQTT_TLS_KEY
  # tls_ca: "/etc/iot-platform-go/certs/ca.pem"       # env: MQTT_TLS_CA  —  optional: enables mutual TLS

auth:
  jwt_secret: "dev-jwt-secret-change-me"              # env: AUTH_JWT_SECRET (or JWT_SECRET)

register:
  enabled: true                                       # env: REGISTER_ENABLED (or AUTH_REGISTER_ENABLED)
  default_role: viewer                                # env: REGISTER_DEFAULT_ROLE  —  admin | operator | viewer
  require_email_verify: true                          # env: REQUIRE_EMAIL_VERIFY (or AUTH_REQUIRE_EMAIL_VERIFY)

admin:
  login: admin                                        # env: ADMIN_LOGIN
  email: admin@cogitor.local                          # env: ADMIN_EMAIL
  password: admin                                     # env: ADMIN_PASSWORD

email:
  mode: log                                           # env: EMAIL_MODE  —  smtp | log
  smtp_host: ""                                       # env: EMAIL_SMTP_HOST (or SMTP_HOST)
  smtp_port: 587                                      # env: EMAIL_SMTP_PORT (or SMTP_PORT)
  smtp_user: ""                                       # env: EMAIL_SMTP_USER (or SMTP_USER)
  smtp_pass: ""                                       # env: EMAIL_SMTP_PASS (or SMTP_PASS)
  smtp_from: "noreply@cogitor.local"                  # env: EMAIL_SMTP_FROM (or SMTP_FROM)

google:
  client_id: ""                                       # env: GOOGLE_CLIENT_ID
  client_secret: ""                                   # env: GOOGLE_CLIENT_SECRET
  # redirect_url: "http://192.168.1.22:8080/api/v1/auth/google/callback"  # env: GOOGLE_REDIRECT_URL

nodered:
  url: "http://192.168.1.22:1880"                     # env: NODERED_URL

rules:
  bus_enabled: true                                   # env: RULES_BUS_ENABLED
  bus_prefix: "platform/v1"                           # env: RULES_BUS_PREFIX

ota_dir: "./data/firmware"                            # env: OTA_DIR

platform:
  public_base_url: "http://192.168.1.22:8080"         # env: PLATFORM_PUBLIC_BASE_URL (device-reachable URL)
  broker_host_public: "192.168.1.22"                  # env: PLATFORM_BROKER_HOST_PUBLIC
  telemetry_retention_days: 30                        # env: PLATFORM_TELEMETRY_RETENTION_DAYS
  rpc_default_timeout_ms: 30000                       # env: PLATFORM_RPC_DEFAULT_TIMEOUT_MS
  lab_allow_unknown_devices: false                    # env: PLATFORM_LAB_ALLOW_UNKNOWN_DEVICES

bootstrap:
  account_slug: "default"                             # env: BOOTSTRAP_ACCOUNT_SLUG
  account_name: "Default"                             # env: BOOTSTRAP_ACCOUNT_NAME
